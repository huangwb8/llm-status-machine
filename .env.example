# HTTP binding
BIND_HOST=0.0.0.0
PORT=4317

# Image used by docker compose and publish scripts.
IMAGE=huangwb8/llm-status-machine

# Mount a host directory that contains experiment workspaces.
# State paths should use the container path, for example /workspaces/examples/project-a.
WORKSPACES_MOUNT=/Volumes/2T01/Github
WORKSPACES_TARGET=/workspaces/examples
WORKSPACES_MOUNT_MODE=rw
DEFAULT_STATE_PATH=/workspaces/examples/buggy-js

# Runtime mode. docker-compose.file.yml defaults to file/inline/memory.
STORAGE_DRIVER=postgres
QUEUE_DRIVER=redis
EVENT_BUS=redis

# Postgres. Change POSTGRES_PASSWORD before sharing a compose environment.
POSTGRES_DB=llm_status_machine
POSTGRES_USER=llm_status
POSTGRES_PASSWORD=llm_status_password
DATABASE_URL=postgres://llm_status:llm_status_password@postgres:5432/llm_status_machine

# Redis. If REDIS_PASSWORD is set, REDIS_URL must include it too.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# API URL exposed to spawned LLM client processes.
LLM_STATUS_MACHINE_API=http://localhost:4317
