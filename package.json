{
  "name": "llm-status-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node --watch server/index.js",
    "client": "vite --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "worker": "node server/worker.js",
    "db:migrate": "node server/db/migrate.js",
    "deps:link": "bash tools/use-external-node-modules.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "bullmq": "^5.77.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.544.0",
    "nanoid": "^5.1.6",
    "pg": "^8.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  }
}
